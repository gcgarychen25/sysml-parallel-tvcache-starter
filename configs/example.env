# Run `cp configs/example.env .env` and edit locally (do not commit .env).
# Model slug must be provider/model-id, e.g. openai/<provider-model>.
MODEL=openai/YOUR_MODEL_ID
# The chosen API key needs to be available in your host shell.
# For OpenAI-compatible vLLM, export OPENAI_API_KEY=EMPTY if the endpoint has no auth.
# OPENAI_API_KEY=...
# Optional: e.g. http://host.docker.internal:8000/v1 (NOT http://localhost:8000/v1 from a Docker agent)
# HARBOR_MODEL_BASE_URL=http://host.docker.internal:8000/v1
# API key env variable name, NOT its secret value:
# HARBOR_MODEL_API_KEY_NAME=OPENAI_API_KEY
# Pi-specific setting required by Harbor when using a custom endpoint:
# HARBOR_PI_MODEL_API=openai-completions
TASK_ID=clack-async-autocomplete-options
# Optional reproducibility pin; verify against the installed Harbor adapter.
# PI_VERSION=1.4.0
