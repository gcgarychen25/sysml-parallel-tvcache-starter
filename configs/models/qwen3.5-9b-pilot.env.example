# Copy to an ignored local file and fill every PLACEHOLDER before the Qwen3.5-9B pilot.
# Pair with teammate's local Qwen3-4B-Instruct runs on the SAME DeepSWE task ids.

export SYSML_MODEL_ID=Qwen/Qwen3.5-9B
export SYSML_MAX_MODEL_LEN=8192
export SYSML_CONTEXT_WINDOW=8192
export SYSML_MAX_TOKENS=2048
export SYSML_GPU_MEMORY_UTILIZATION=0.85
export SYSML_MAX_NUM_SEQS=1
# Qwen3.5 tool parser (not hermes). Requires a Qwen3.5-capable vLLM build.
export SYSML_TOOL_CALL_PARSER=qwen3_coder
export SYSML_VLLM_EXTRA_ARGS='--language-model-only --reasoning-parser qwen3 --trust-remote-code'

export MODEL=openai/Qwen/Qwen3.5-9B
export OPENAI_API_KEY=EMPTY
export OPENAI_BASE_URL=http://127.0.0.1:18081/v1

# Shared experiment knobs (match teammate)
export PI_VERSION=1.4.0
export SYSML_MAX_TURNS=PLACEHOLDER_agree_with_teammate
export SYSML_THINKING=PLACEHOLDER_on_or_off_agree_with_teammate
export SYSML_TASK_ID=PLACEHOLDER_deep_swe_task_folder_name
export SYSML_TASK_PATH=PLACEHOLDER_vendor/deep-swe/tasks/$SYSML_TASK_ID

# Fresh per allocation
export SYSML_ALLOC_NODE=PLACEHOLDER_nidXXXXXX
export SYSML_TUNNEL_LOCAL_PORT=18082
export SYSML_GATEWAY_BACKEND_PORT=18082
export SYSML_MODEL_VOLUME=PLACEHOLDER_sysml-model-m4999-JOBID
export SYSML_JOB_NAME=PLACEHOLDER_m4999-pi-JOBID
export SYSML_COMPOSE_OVERLAY=PLACEHOLDER_.local-smoke/m4999-JOBID-compose.json
export SYSML_GATEWAY_ENV_FILE=PLACEHOLDER_.local-smoke/gateway.env
export SYSML_MODEL_RECORDS=PLACEHOLDER_results/m4999-JOBID-model-records
