# B2: Pi × Qwen3.8-Flash-Next-FP8 × happy-dom pass@5 (model vs A3b).
# BF16 Flash-Next ~423 GB — use official FP8. 4×A100-40GB is tight (~250 GB
# recipe); start with 128K ctx / util 0.90; on OOM shorten len or add GPUs.
#
# One-time: SYSML_REMOTE_ROOT=... python scripts/download_qwen3_8_flash_next_fp8.py
#
#   set -a && source configs/models/qwen3.8-flash-happydom-pi.env.example && set +a
#   export SYSML_NERSC_USER=<user>
#   export SYSML_REMOTE_ROOT=/pscratch/sd/<letter>/<user>/sysml_parallel_tvcache
#   bash scripts/run_experiment.sh none

export SYSML_MODEL_ID=Qwen/Qwen3.8-Flash-Next-FP8
export MODEL=openai/Qwen/Qwen3.8-Flash-Next-FP8
export SYSML_HARBOR_AGENT=pi

# Conservative context for first fit on 4×40GB; raise toward 256K after READY.
export SYSML_MAX_MODEL_LEN=131072
export SYSML_CONTEXT_WINDOW=131072
export SYSML_MAX_TOKENS=32768
export SYSML_MAX_TURNS=250
export SYSML_THINKING=xhigh

export SYSML_PASS_K=5
export SYSML_HARBOR_N=5
export SYSML_MAX_NUM_SEQS=5
export SYSML_TASK_PARALLEL=1

export SYSML_GPUS=4
export SYSML_TENSOR_PARALLEL_SIZE=4
export SYSML_CPUS_PER_TASK=128
export SYSML_MEM=220G
export SYSML_GPU_MEMORY_UTILIZATION=0.90
export SYSML_SLURM_QOS=interactive
export SYSML_ALLOC_TIME=04:00:00
export SYSML_TASKS_PER_ALLOC=1
export SYSML_SERVE_WAIT_ITERS=600

export SYSML_TASK_LIST=configs/experiment-tasks-easy1.txt

export SYSML_TOOL_CALL_PARSER=qwen3_coder
export SYSML_VLLM_EXTRA_ARGS='--reasoning-parser qwen3 --language-model-only --trust-remote-code'
export PI_VERSION=1.4.0
export SYSML_ALLOW_AGENT_EGRESS=1

export SYSML_JOB_PREFIX=char-qwen38-flash-fp8-happydom-t250-xh
export SYSML_TUNNEL_LOCAL_PORT=18095

export OPENAI_API_KEY=EMPTY
export OPENAI_BASE_URL=http://127.0.0.1:18081/v1
