# Copy to an ignored local file (for example .local-smoke/qwen3-8b-pilot.env)
# and fill every PLACEHOLDER before launching the tool-using pilot.
#
# Why 8B first: installed NERSC vLLM is 0.31.0. Proposal model Qwen/Qwen3.8-27B
# needs a newer multimodal/vLLM stack; do not swap it in until that is validated.

# === FILL THESE ===
export SYSML_MODEL_ID=Qwen/Qwen3-8B
export SYSML_MAX_MODEL_LEN=8192
export SYSML_CONTEXT_WINDOW=8192
export SYSML_MAX_TOKENS=2048
export SYSML_GPU_MEMORY_UTILIZATION=0.85
export SYSML_MAX_NUM_SEQS=1
export SYSML_TOOL_CALL_PARSER=hermes

# Mac-side Harbor/Pi (after tunnel + gateway are up)
export MODEL=openai/Qwen/Qwen3-8B
export OPENAI_API_KEY=EMPTY
export OPENAI_BASE_URL=http://127.0.0.1:18081/v1

# Fresh per allocation; do not reuse old node/volume/port names
export SYSML_ALLOC_NODE=PLACEHOLDER_nidXXXXXX
export SYSML_TUNNEL_LOCAL_PORT=18082
export SYSML_GATEWAY_BACKEND_PORT=18082
export SYSML_MODEL_VOLUME=PLACEHOLDER_sysml-model-m4999-JOBID
export SYSML_JOB_NAME=PLACEHOLDER_m4999-pi-JOBID
export SYSML_COMPOSE_OVERLAY=PLACEHOLDER_.local-smoke/m4999-JOBID-compose.json
export SYSML_GATEWAY_ENV_FILE=PLACEHOLDER_.local-smoke/gateway.env
export SYSML_MODEL_RECORDS=PLACEHOLDER_results/m4999-JOBID-model-records
