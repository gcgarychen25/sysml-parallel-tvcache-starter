# Optional knobs for forced-parallel stress on NERSC + vLLM.
# Prefer the CLI flag (no need to export SYSML_PARALLEL_STRESS yourself):
#
#   export SYSML_NERSC_USER=<user>
#   export SYSML_REMOTE_ROOT=/pscratch/sd/<letter>/<user>/sysml_parallel_tvcache
#   export SYSML_SSH_HOST=perlmutter SYSML_SLURM_ACCOUNT=m4999
#   set -a && source configs/models/qwen3.5-9b-pilot.env.example && set +a
#   bash scripts/run_experiment.sh none --parallel-test
#   bash scripts/analyze_characterization_wave.sh "$SYSML_JOB_PREFIX"
#
# This file only sets prepare/prefix defaults if you still want them via env.

export SYSML_PREPARE=1
export SYSML_JOB_PREFIX="${SYSML_JOB_PREFIX:-stress-nersc-parallel}"

